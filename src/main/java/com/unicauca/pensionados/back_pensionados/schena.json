{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sistema de Gestión de Pensiones - Backend API Schema",
  "description": "Schema completo para el backend del Sistema de Gestión de Cuotas Partes",
  "definitions": {
    "Entity": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único de la entidad" },
        "nit": { "type": "string", "description": "NIT de la entidad (único)" },
        "nombre": { "type": "string", "description": "Nombre de la entidad" },
        "correo": { "type": "string", "format": "email", "description": "Correo de contacto" },
        "telefono": { "type": "string", "description": "Teléfono de contacto" },
        "estado": { "type": "string", "enum": ["Activo", "Inactivo"], "default": "Activo" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "pensionados": { "type": "array", "items": { "$ref": "#/definitions/Pensionado" } }
      },
      "required": ["id", "nit", "nombre", "correo", "telefono"]
    },
    "Resolucion": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único de la resolución" },
        "numeroResolucion": { "type": "string", "description": "Número de la resolución" },
        "fechaResolucion": { "type": "string", "format": "date", "description": "Fecha de la resolución" },
        "valorResolucion": { "type": "number", "description": "Valor de la resolución en COP" },
        "estado": { "type": "string", "enum": ["Vigente", "Cancelada", "Suspendida"], "default": "Vigente" },
        "tipoResolucion": { "type": "string", "enum": ["Jubilación", "Invalidez", "Viudedad", "Orfandad"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "numeroResolucion", "fechaResolucion", "valorResolucion"]
    },
    "Pensionado": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único del pensionado" },
        "cedula": { "type": "string", "description": "Cédula del pensionado (único)" },
        "nombre": { "type": "string", "description": "Nombre completo" },
        "apellido": { "type": "string", "description": "Apellido" },
        "correo": { "type": "string", "format": "email" },
        "telefono": { "type": "string" },
        "fechaNacimiento": { "type": "string", "format": "date" },
        "estado": { "type": "string", "enum": ["Activo", "Fallecido", "Pensión Suspendida", "Jubilado"], "default": "Activo" },
        "entityNit": { "type": "string", "description": "NIT de la entidad a la que pertenece" },
        "entityId": { "type": "string", "description": "ID de la entidad" },
        "resoluciones": { "type": "array", "items": { "$ref": "#/definitions/Resolucion" }, "description": "Array de resoluciones asociadas" },
        "pensionadoSustituto": { "type": "string", "nullable": true, "description": "ID del pensionado sustituto (en caso de fallecimiento)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "cedula", "nombre", "apellido", "estado", "entityNit", "resoluciones"]
    },
    "Periodo": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombrePeriodo": { "type": "string", "description": "Ej: 2024-01, 2024-Q1" },
        "fechaInicio": { "type": "string", "format": "date" },
        "fechaFin": { "type": "string", "format": "date" },
        "estado": { "type": "string", "enum": ["Abierto", "Cerrado", "En Liquidación"], "default": "Abierto" },
        "ipc": { "type": "number", "description": "Índice de Precios al Consumidor" },
        "dtf": { "type": "number", "description": "DTF vigente para el período" },
        "smmlv": { "type": "number", "description": "Salario Mínimo Mensual Legal Vigente" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nombrePeriodo", "fechaInicio", "fechaFin"]
    },
    "DTFHistorico": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string", "format": "date", "description": "Fecha del DTF" },
        "valor": { "type": "number", "description": "Valor del DTF" },
        "periodicidad": { "type": "string", "enum": ["Diario", "Semanal", "Mensual"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fecha", "valor"]
    },
    "SMMLVHistorico": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ano": { "type": "integer", "description": "Año del SMMLV" },
        "valor": { "type": "number", "description": "Valor del SMMLV en COP" },
        "vigenciaDesde": { "type": "string", "format": "date" },
        "vigenciaHasta": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ano", "valor"]
    },
    "CuotaPagar": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pensionadoId": { "type": "string", "description": "ID del pensionado" },
        "pensionadoCedula": { "type": "string" },
        "pensionadoNombre": { "type": "string" },
        "periodoId": { "type": "string", "description": "ID del período" },
        "valorCuota": { "type": "number", "description": "Valor de la cuota" },
        "valorCorriente": { "type": "number", "description": "Valor corriente acumulado" },
        "valorNoCorriente": { "type": "number", "description": "Valor no corriente (mora)" },
        "valorPrescrito": { "type": "number", "description": "Valor prescrito (30% del no corriente)" },
        "estado": { "type": "string", "enum": ["Pendiente", "Pagada", "Parcialmente Pagada", "Vencida"], "default": "Pendiente" },
        "fechaVencimiento": { "type": "string", "format": "date" },
        "fechaPago": { "type": "string", "format": "date", "nullable": true },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "pensionadoId", "periodoId", "valorCuota"]
    },
    "CuotaCobrar": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entityId": { "type": "string", "description": "ID de la entidad deudora" },
        "entityNit": { "type": "string" },
        "entityNombre": { "type": "string" },
        "periodoId": { "type": "string" },
        "valorCuota": { "type": "number", "description": "Valor de la cuota a cobrar" },
        "valorCorriente": { "type": "number", "description": "Valor corriente acumulado" },
        "valorNoCorriente": { "type": "number", "description": "Valor no corriente (mora)" },
        "valorPrescrito": { "type": "number", "description": "Valor prescrito (30% del no corriente)" },
        "estado": { "type": "string", "enum": ["Pendiente", "Cobrada", "Parcialmente Cobrada", "Vencida"], "default": "Pendiente" },
        "fechaVencimiento": { "type": "string", "format": "date" },
        "fechaCobro": { "type": "string", "format": "date", "nullable": true },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "entityId", "periodoId", "valorCuota"]
    },
    "LiquidacionPensionado": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pensionadoId": { "type": "string" },
        "pensionadoCedula": { "type": "string" },
        "pensionadoNombre": { "type": "string" },
        "periodoId": { "type": "string" },
        "periodoNombre": { "type": "string" },
        "totalAPagar": { "type": "number", "description": "Total a pagar al pensionado" },
        "valorCorriente": { "type": "number" },
        "valorNoCorriente": { "type": "number" },
        "valorPrescrito": { "type": "number" },
        "descuentos": { "type": "number", "default": 0 },
        "netoPagable": { "type": "number" },
        "estado": { "type": "string", "enum": ["Pendiente", "Liquidada", "Pagada"], "default": "Pendiente" },
        "fechaLiquidacion": { "type": "string", "format": "date", "nullable": true },
        "fechaPago": { "type": "string", "format": "date", "nullable": true },
        "detalles": { "type": "array", "items": { "type": "object" }, "description": "Array con detalles de la liquidación" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "pensionadoId", "periodoId", "totalAPagar"]
    },
    "LiquidacionEntidad": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entityId": { "type": "string" },
        "entityNit": { "type": "string" },
        "entityNombre": { "type": "string" },
        "periodoId": { "type": "string" },
        "periodoNombre": { "type": "string" },
        "totalACobrar": { "type": "number", "description": "Total a cobrar a la entidad" },
        "valorCorriente": { "type": "number" },
        "valorNoCorriente": { "type": "number" },
        "valorPrescrito": { "type": "number" },
        "descuentos": { "type": "number", "default": 0 },
        "neto": { "type": "number" },
        "estado": { "type": "string", "enum": ["Pendiente", "Liquidada", "Cobrada"], "default": "Pendiente" },
        "fechaLiquidacion": { "type": "string", "format": "date", "nullable": true },
        "fechaCobro": { "type": "string", "format": "date", "nullable": true },
        "pensionadosCount": { "type": "integer", "description": "Cantidad de pensionados de esta entidad" },
        "detalles": { "type": "array", "items": { "type": "object" }, "description": "Array con detalles por pensionado" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "entityId", "periodoId", "totalACobrar"]
    },
    "Novedad": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipo": { "type": "string", "enum": ["Fallecimiento", "Sustitución", "Cambio de Resolución", "Agregar Resolución", "Cambio de Estado", "Cambio de Datos", "Otro"], "description": "Tipo de novedad" },
        "descripcion": { "type": "string", "description": "Descripción detallada de la novedad" },
        "pensionadoId": { "type": "string", "nullable": true },
        "pensionadoCedula": { "type": "string", "nullable": true },
        "pensionadoNombre": { "type": "string", "nullable": true },
        "pensionadoSustitutoId": { "type": "string", "nullable": true, "description": "En caso de sustitución" },
        "pensionadoSustitutoCedula": { "type": "string", "nullable": true },
        "resolucionAnterior": { "type": "object", "nullable": true, "description": "Resolución anterior (cambios)" },
        "resolucionNueva": { "type": "object", "nullable": true, "description": "Resolución nueva (cambios)" },
        "cambiosRealizados": { "type": "object", "nullable": true, "description": "Objeto con los campos que cambiaron" },
        "usuarioId": { "type": "string", "description": "ID del usuario que registró la novedad" },
        "usuarioNombre": { "type": "string" },
        "usuarioEmail": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tipo", "descripcion", "usuarioId"]
    },
    "Reporte": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "tipo": { "type": "string", "enum": ["Cuotas por Pagar", "Cuotas por Cobrar", "Liquidaciones", "Novedades", "Análisis Financiero"] },
        "filtros": { "type": "object", "description": "Filtros aplicados al reporte" },
        "datos": { "type": "array", "items": { "type": "object" }, "description": "Array de registros del reporte" },
        "totales": { "type": "object", "properties": { "totalRegistros": { "type": "integer" }, "totalValor": { "type": "number" }, "totalCorriente": { "type": "number" }, "totalNoCorriente": { "type": "number" }, "totalPrescrito": { "type": "number" } } },
        "generadoEn": { "type": "string", "format": "date-time" },
        "generadoPor": { "type": "string" }
      },
      "required": ["id", "titulo", "tipo", "datos"]
    },
    "Usuario": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "nombre": { "type": "string" },
        "apellido": { "type": "string" },
        "rol": { "type": "string", "enum": ["Administrador", "Gestor", "Consultor", "Invitado"], "default": "Consultor" },
        "permisos": { "type": "array", "items": { "type": "string" }, "description": "Array de permisos asignados" },
        "estado": { "type": "string", "enum": ["Activo", "Inactivo", "Suspendido"], "default": "Activo" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "nombre", "rol"]
    }
  },
  "endpoints": {
    "GET /api/entidades": {
      "description": "Obtener todas las entidades",
      "response": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "array", "items": { "$ref": "#/definitions/Entity" } },
          "total": { "type": "integer" }
        }
      }
    },
    "GET /api/entidades/:id": {
      "description": "Obtener una entidad por ID",
      "response": { "$ref": "#/definitions/Entity" }
    },
    "POST /api/entidades": {
      "description": "Crear una nueva entidad",
      "request": { "type": "object", "properties": { "nit": { "type": "string" }, "nombre": { "type": "string" }, "correo": { "type": "string", "format": "email" }, "telefono": { "type": "string" } }, "required": ["nit", "nombre", "correo", "telefono"] },
      "response": { "$ref": "#/definitions/Entity" }
    },
    "PUT /api/entidades/:id": {
      "description": "Actualizar una entidad",
      "response": { "$ref": "#/definitions/Entity" }
    },
    "DELETE /api/entidades/:id": {
      "description": "Eliminar una entidad (soft delete)",
      "response": { "type": "object", "properties": { "success": { "type": "boolean" }, "message": { "type": "string" } } }
    },
    "GET /api/entidades/:nit/pensionados": {
      "description": "Obtener pensionados de una entidad específica",
      "response": { "type": "array", "items": { "$ref": "#/definitions/Pensionado" } }
    },
    "GET /api/pensionados": {
      "description": "Obtener todos los pensionados",
      "parameters": { "filtro": { "type": "string" }, "estado": { "type": "string" }, "entityNit": { "type": "string" } },
      "response": { "type": "array", "items": { "$ref": "#/definitions/Pensionado" } }
    },
    "GET /api/pensionados/:id": {
      "description": "Obtener un pensionado por ID",
      "response": { "$ref": "#/definitions/Pensionado" }
    },
    "POST /api/pensionados": {
      "description": "Crear un nuevo pensionado con resoluciones",
      "request": { "type": "object", "properties": { "cedula": { "type": "string" }, "nombre": { "type": "string" }, "apellido": { "type": "string" }, "correo": { "type": "string", "format": "email" }, "telefono": { "type": "string" }, "fechaNacimiento": { "type": "string", "format": "date" }, "entityNit": { "type": "string" }, "resoluciones": { "type": "array", "items": { "$ref": "#/definitions/Resolucion" } } }, "required": ["cedula", "nombre", "apellido", "entityNit", "resoluciones"] },
      "response": { "$ref": "#/definitions/Pensionado" }
    },
    "PUT /api/pensionados/:id": {
      "description": "Actualizar pensionado (incluyendo adición de resoluciones)",
      "response": { "$ref": "#/definitions/Pensionado" }
    },
    "DELETE /api/pensionados/:id": {
      "description": "Eliminar pensionado",
      "response": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "POST /api/periodos": {
      "description": "Crear un nuevo período",
      "request": { "type": "object", "properties": { "nombrePeriodo": { "type": "string" }, "fechaInicio": { "type": "string", "format": "date" }, "fechaFin": { "type": "string", "format": "date" }, "ipc": { "type": "number" }, "dtf": { "type": "number" }, "smmlv": { "type": "number" } }, "required": ["nombrePeriodo", "fechaInicio", "fechaFin"] },
      "response": { "$ref": "#/definitions/Periodo" }
    },
    "GET /api/periodos": {
      "description": "Obtener todos los períodos",
      "response": { "type": "array", "items": { "$ref": "#/definitions/Periodo" } }
    },
    "PUT /api/periodos/:id": {
      "description": "Actualizar un período",
      "response": { "$ref": "#/definitions/Periodo" }
    },
    "DELETE /api/periodos/:id": {
      "description": "Eliminar un período",
      "response": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "GET /api/dtf": {
      "description": "Obtener histórico de DTF",
      "parameters": { "desde": { "type": "string", "format": "date" }, "hasta": { "type": "string", "format": "date" } },
      "response": { "type": "array", "items": { "$ref": "#/definitions/DTFHistorico" } }
    },
    "POST /api/dtf": {
      "description": "Crear registro de DTF",
      "request": { "$ref": "#/definitions/DTFHistorico" },
      "response": { "$ref": "#/definitions/DTFHistorico" }
    },
    "PUT /api/dtf/:id": {
      "description": "Actualizar DTF",
      "response": { "$ref": "#/definitions/DTFHistorico" }
    },
    "DELETE /api/dtf/:id": {
      "description": "Eliminar DTF",
      "response": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "GET /api/smmlv": {
      "description": "Obtener histórico de SMMLV",
      "response": { "type": "array", "items": { "$ref": "#/definitions/SMMLVHistorico" } }
    },
    "POST /api/smmlv": {
      "description": "Crear registro de SMMLV",
      "request": { "$ref": "#/definitions/SMMLVHistorico" },
      "response": { "$ref": "#/definitions/SMMLVHistorico" }
    },
    "PUT /api/smmlv/:id": {
      "description": "Actualizar SMMLV",
      "response": { "$ref": "#/definitions/SMMLVHistorico" }
    },
    "DELETE /api/smmlv/:id": {
      "description": "Eliminar SMMLV",
      "response": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "GET /api/cuotas-pagar": {
      "description": "Obtener cuotas por pagar con filtros",
      "parameters": { "periodoId": { "type": "string" }, "estado": { "type": "string" }, "pensionadoId": { "type": "string" } },
      "response": { "type": "array", "items": { "$ref": "#/definitions/CuotaPagar" } }
    },
    "POST /api/cuotas-pagar": {
      "description": "Crear nueva cuota por pagar",
      "response": { "$ref": "#/definitions/CuotaPagar" }
    },
    "PUT /api/cuotas-pagar/:id": {
      "description": "Actualizar cuota por pagar",
      "response": { "$ref": "#/definitions/CuotaPagar" }
    },
    "DELETE /api/cuotas-pagar/:id": {
      "description": "Eliminar cuota por pagar",
      "response": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "GET /api/cuotas-cobrar": {
      "description": "Obtener cuotas por cobrar con filtros",
      "parameters": { "periodoId": { "type": "string" }, "estado": { "type": "string" }, "entityNit": { "type": "string" } },
      "response": { "type": "array", "items": { "$ref": "#/definitions/CuotaCobrar" } }
    },
    "POST /api/cuotas-cobrar": {
      "description": "Crear nueva cuota por cobrar",
      "response": { "$ref": "#/definitions/CuotaCobrar" }
    },
    "PUT /api/cuotas-cobrar/:id": {
      "description": "Actualizar cuota por cobrar",
      "response": { "$ref": "#/definitions/CuotaCobrar" }
    },
    "DELETE /api/cuotas-cobrar/:id": {
      "description": "Eliminar cuota por cobrar",
      "response": { "type": "object", "properties": { "success": { "type": "boolean" } } }
    },
    "GET /api/liquidaciones/pensionado/:pensionadoId": {
      "description": "Obtener liquidaciones de un pensionado",
      "response": { "type": "array", "items": { "$ref": "#/definitions/LiquidacionPensionado" } }
    },
    "POST /api/liquidaciones/pensionado": {
      "description": "Crear liquidación para pensionado",
      "response": { "$ref": "#/definitions/LiquidacionPensionado" }
    },
    "PUT /api/liquidaciones/pensionado/:id": {
      "description": "Actualizar liquidación de pensionado",
      "response": { "$ref": "#/definitions/LiquidacionPensionado" }
    },
    "GET /api/liquidaciones/entidad/:entityNit": {
      "description": "Obtener liquidaciones de una entidad",
      "response": { "type": "array", "items": { "$ref": "#/definitions/LiquidacionEntidad" } }
    },
    "POST /api/liquidaciones/entidad": {
      "description": "Crear liquidación para entidad",
      "response": { "$ref": "#/definitions/LiquidacionEntidad" }
    },
    "PUT /api/liquidaciones/entidad/:id": {
      "description": "Actualizar liquidación de entidad",
      "response": { "$ref": "#/definitions/LiquidacionEntidad" }
    },
    "GET /api/novedades": {
      "description": "Obtener todas las novedades",
      "parameters": { "tipo": { "type": "string" }, "desde": { "type": "string", "format": "date" }, "hasta": { "type": "string", "format": "date" }, "pensionadoId": { "type": "string" } },
      "response": { "type": "array", "items": { "$ref": "#/definitions/Novedad" } }
    },
    "POST /api/novedades": {
      "description": "Crear una nueva novedad (auditoría automática)",
      "request": { "$ref": "#/definitions/Novedad" },
      "response": { "$ref": "#/definitions/Novedad" }
    },
    "GET /api/reportes/cuotas-pagar": {
